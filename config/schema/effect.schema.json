{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Effect",
  "description": "Stardew View screen or glyph effect definition",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "type": { "enum": ["screen", "glyph"] },
    "params": { "type": "object" },
    "enabled": { "type": "boolean" },
    "priority": { "type": "integer", "minimum": 0 }
  },
  "required": ["name", "type", "params"]
}